# Dependencies
**/node_modules/

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.test.example

# Private keys, certificates, and credentials
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/credentials.json
**/service-account*.json
**/secrets/
**/.secret/

# Build, cache, coverage, and deployment output
**/dist/
**/dist-ssr/
**/build/
**/coverage/
**/.cache/
**/.tmp/
**/.vercel/

# Logs and runtime files
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/*.pid
**/*.pid.lock

# Local databases and Docker overrides
**/*.sqlite
**/*.sqlite3
**/docker-compose.override.yml

# Agent instructions and local agent state
**/Agents.md
**/AGENTS.md
**/.agents/

# Editor and operating-system files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
**/*.swp
**/*.swo
